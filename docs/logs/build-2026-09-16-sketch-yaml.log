# Kiem chung sketch.yaml: build KHONG truyen --fqbn, arduino-cli phai tu lay
# default_fqbn tu tep. Chay trong moi truong tro ly ngay 2026-09-16.
# Chi bien dich tren PC. Arduino IDE co doc sketch.yaml hay khong: chua kiem.

$ arduino-cli compile --warnings all firmware/esp32s3/PsramTest
