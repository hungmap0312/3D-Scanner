# Profile day du do --dump-profile sinh ra, KHONG dua vao sketch.yaml vi che do
# profile tai core vao thu muc rieng; ghi lai de dung khi can ghim phien ban:
profiles:
  esp32s3:
    fqbn: esp32:esp32:esp32s3:PSRAM=opi
    platforms:
      - platform: esp32:esp32 (3.3.11)
        platform_index_url: https://raw.githubusercontent.com/espressif/arduino-esp32/gh-pages/package_esp32_index.json
